NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/weather_dashboard
# Optional. Without a valid key, the backend uses Open-Meteo.
# OPENWEATHER_API_KEY=your_openweathermap_api_key
JWT_SECRET=replace_with_a_random_32_character_or_longer_secret
CLIENT_URL=http://localhost:4200
ANGULAR_DIST_PATH=../../frontend/dist/frontend/browser
# Set only when the backend is behind a known number of trusted reverse proxies.
# TRUST_PROXY=1
